# Inkbin Environment Configuration
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-strong-secret-key-min-32-chars
HOST=0.0.0.0
PORT=8000

# Base URL (for generated public links)
BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL in production/docker, fallback to SQLite locally)
DATABASE_URL=postgresql+asyncpg://inkbin:inkbin_secret@db:5432/inkbin_db

# Redis Configuration (Fallback to in-memory cache/rate limiting if empty or unavailable)
REDIS_URL=redis://redis:6379/0

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=100

# Maximum Paste Payload in Bytes (default 1MB = 1048576)
MAX_PASTE_BYTES=1048576

# Allowed Expiration Options (comma-separated list, e.g. 1h,1d,1w,1m,never)
EXPIRATION_OPTIONS=1h,1d,1w,1m,never

# Reverse Proxy & TLS (Caddy / Let's Encrypt / Portainer)
# Set COMPOSE_PROFILES=caddy (or proxy / production) to enable the integrated Caddy container (ports 80 and 443)
# For setups with external reverse proxy (Traefik, Nginx, Cloudflare) or without Caddy,
# use docker-compose.standalone.yml or omit COMPOSE_PROFILES.
# COMPOSE_PROFILES=caddy
# Public domain for automatic Let's Encrypt certificate issuance
# DOMAIN=paste.example.com
# Email for Let's Encrypt renewal notifications
# ACME_EMAIL=admin@example.com
# TLS mode: defaults to "internal" (self-signed). In production with a public domain, set to "production" (or leave empty) to use Let's Encrypt
# TLS_MODE=internal
