# Inkbin Environment Configuration
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-strong-secret-key-min-32-chars
HOST=0.0.0.0
PORT=8000

# Base URL (for generated public links)
BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL in production/docker, fallback to SQLite locally)
DATABASE_URL=postgresql+asyncpg://inkbin:inkbin_secret@db:5432/inkbin_db

# Redis Configuration (Fallback to in-memory cache/rate limiting if empty or unavailable)
REDIS_URL=redis://redis:6379/0

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=100

# Maximum Paste Payload in Bytes (default 1MB = 1048576)
MAX_PASTE_BYTES=1048576
